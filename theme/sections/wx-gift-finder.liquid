{%- comment -%}
  Wix replica: Gift Finder (shop-june.com/consultation-3-1), measured at 1440px desktop and 375px phone.
  The quiz is the same Quizell embed the Wix page uses.
{%- endcomment -%}
{%- render 'wx-base' -%}
{%- capture arrow -%}<svg viewBox="0 0 22 10" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M0 5h20.5M16.5 1l4 4-4 4"/></svg>{%- endcapture -%}
<div class="wx wxgf">
  <section class="wxgf__quiz">
    <div id="{{ section.settings.quiz_id }}" data-quizLang="en"></div>
    <script data-qz-key="{{ section.settings.quiz_id }}" src="https://api.quizell.com/js/qzembed.js?v=29757"></script>
  </section>
  <section class="wxgf__stuck">
    <p class="wxgf__txt wxE"><span class="wxA">Still stuck?</span><br>Message our stylist to find the perfect gift.</p>
    <a class="wxgf__call wxB" href="{{ section.settings.call_url }}"{% if section.settings.call_url contains 'http' %} target="_blank" rel="noopener"{% endif %}>Schedule The Call {{ arrow }}</a>
  </section>
  <div class="wxgf__img"><img src="{{ 'wx-img-82c6fba8.jpg' | file_img_url: '2400x' }}" alt="Find the perfect gift - House of June" loading="lazy"></div>
</div>
{%- capture wxcss -%}
  html:root body .wxgf__quiz{min-height:u(777);background:#F7F5F1}
  html:root body .wxgf__quiz iframe{display:block;width:100%;border:0}
  html:root body .wxgf__stuck{height:u(147);margin-top:u(8);padding-top:u(30);text-align:center;background:rgba(241,240,237,.6)}
  html:root body .wxgf__txt{font-size:u(13.279) !important;line-height:u(19.919);color:#000}
  html:root body .wxgf__txt span{font-size:inherit !important}
  html:root body .wxgf__call{display:inline-flex !important;align-items:center;gap:u(10);margin-top:u(22);font-size:u(12) !important;line-height:u(15);color:#996E5C}
  html:root body .wxgf__call svg{width:u(14);height:u(8)}
  html:root body .wxgf__img{height:u(355)}
  html:root body .wxgf__img img{width:100%;height:100%;object-fit:cover}
  @media (min-width:750px){
    html:root body .wxgf__quiz{min-height:u(1012);padding-top:u(34)}
    html:root body .wxgf__stuck{height:u(189);margin-top:u(29);padding-top:u(27)}
    html:root body .wxgf__txt{font-size:u(21.375) !important;line-height:u(38.475)}
    html:root body .wxgf__call{margin-top:u(26);font-size:u(16) !important;line-height:u(20);gap:u(12)}
    html:root body .wxgf__call svg{width:u(16);height:u(9)}
    html:root body .wxgf__img{height:u(814)}
  }
{%- endcapture -%}<style>{{ wxcss | replace: 'u(', 'calc(var(--u)*' }}</style>
{% schema %}
{
  "name": "Wix gift finder",
  "settings": [
    { "type": "text", "id": "quiz_id", "label": "Quizell quiz ID", "default": "dY9jB9" },
    { "type": "text", "id": "call_url", "label": "Schedule The Call link", "default": "https://wa.me/918920108880?text=Hi%2C%20I%27d%20like%20help%20finding%20a%20gift" }
  ],
  "presets": [{ "name": "Wix gift finder" }]
}
{% endschema %}
