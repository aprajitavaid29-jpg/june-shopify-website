<script>
  (function(){
    document.querySelectorAll('.wxab [data-wxab-slider]').forEach(function(s){
      var t=s.querySelector('.wxab__track'),b=s.querySelector('[data-next]');if(!t||!b)return;
      b.addEventListener('click',function(){
        var f=t.querySelector('figure'),step=f.getBoundingClientRect().width+parseFloat(getComputedStyle(t).columnGap||0);
        if(t.scrollLeft+t.clientWidth>=t.scrollWidth-4){t.scrollTo({left:0});}else{t.scrollBy({left:step});}
      });
    });
    /* the Wix strip opens part-way along, with the first picture cut at the left edge */
    var st=document.querySelector('.wxab [data-wxab-strip]');
    if(st&&window.matchMedia('(min-width:750px)').matches){st.style.scrollBehavior='auto';st.scrollLeft=st.scrollWidth*0.115;}
  })();
</script>
