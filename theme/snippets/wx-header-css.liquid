{%- capture wxcss -%}
  .shopify-section:has(> .wxhd){position:sticky;top:0;z-index:60}
  html:root body .wxhd{background:#fff;color:#000}
  html:root body .wxhd__bar{position:relative;height:var(--wx-head);display:flex;align-items:center}
  html:root body .wxhd__logo{position:absolute;left:u(16);top:calc((var(--wx-head) - var(--u) * 23) / 2);width:u(79);height:u(23)}
  html:root body .wxhd__logo img{width:100%;height:100%;object-fit:cover}
  html:root body .wxhd__desk{display:none}
  html:root body .wxhd__icons{position:absolute;top:0;bottom:0;right:u(19);display:flex;align-items:center;gap:u(14)}
  html:root body .wxhd__icons a,html:root body .wxhd__icons button{position:relative;display:flex;align-items:center;justify-content:center;width:u(18);height:u(18);padding:0;border:0;background:none;color:#000;cursor:pointer}
  html:root body .wxhd__icons svg{width:u(17);height:u(17)}
  html:root body .wxhd__burger{width:u(24) !important;height:u(20) !important;margin-left:u(-2)}
  html:root body .wxhd__burger svg{width:u(24) !important;height:u(20) !important}
  html:root body .wxhd__count{position:absolute;top:u(-6);right:u(-8);min-width:u(15);height:u(15);border-radius:u(8);background:var(--wx-brown);color:#fff;font-size:u(9) !important;line-height:u(15);text-align:center;padding:0 u(3)}
  html:root body .wxhd__drawer{position:fixed;inset:0;z-index:100;background:#fff;padding:u(114) u(19) u(40);overflow-y:auto}
  html:root body .wxhd__drawer[hidden]{display:none}
  html:root body .wxhd__close{position:absolute;top:u(22);right:u(22);width:u(20);height:u(20);padding:0;border:0;background:none;color:#000;cursor:pointer}
  html:root body .wxhd__close svg{width:u(20);height:u(20)}
  html:root body .wxhd__list,html:root body .wxhd__sub,html:root body .wxhd__sub2{list-style:none;margin:0;padding:0}
  html:root body .wxhd__list > li{margin:0 0 u(37)}
  html:root body .wxhd__list > li > a,html:root body .wxhd__row > a{font-size:u(16) !important;line-height:u(20);letter-spacing:u(.8) !important;color:#000}
  html:root body .wxhd__row{display:flex;align-items:center;gap:u(8)}
  html:root body .wxhd__chev{width:u(14);height:u(14);padding:0;border:0;background:none;color:#000;cursor:pointer;transition:transform .2s}
  html:root body .wxhd__chev svg{width:u(9);height:u(6)}
  html:root body .wxhd__chev[aria-expanded='true']{transform:rotate(180deg)}
  html:root body .wxhd__sub{padding:u(20) 0 0 u(14)}
  html:root body .wxhd__sub > li{margin:0 0 u(16)}
  html:root body .wxhd__sub a{font-size:u(14) !important;color:#000}
  html:root body .wxhd__sub2{padding:u(12) 0 0 u(14)}
  html:root body .wxhd__sub2 li{margin:0 0 u(10)}
  html:root body .wxhd__sub2 a{font-size:u(13) !important;color:var(--wx-grey)}
  body.wx-lock{overflow:hidden}
  @media (min-width:750px){
    html:root body .wxhd__logo{left:u(34);top:0;width:u(105);height:u(67)}
    html:root body .wxhd__burger{display:none !important}
    html:root body .wxhd__desk{display:flex;position:absolute;top:0;bottom:0;right:u(181);align-items:center;gap:u(48)}
    html:root body .wxhd__di{position:relative;height:100%;display:flex;align-items:center}
    html:root body .wxhd__di > a{font-size:u(11) !important;letter-spacing:u(1.1) !important;line-height:u(15);color:#000;padding-top:u(4)}
    html:root body .wxhd__dd{display:none;position:fixed;left:0;right:0;top:var(--wx-head);background:#fff;padding:u(36) u(80) u(44);gap:u(70);box-shadow:0 u(8) u(16) rgba(0,0,0,.04)}
    html:root body .wxhd__di:hover .wxhd__dd{display:flex}
    html:root body .wxhd__ddcol{display:flex;flex-direction:column;gap:u(12)}
    html:root body .wxhd__ddh{font-family:'wxH',Arial,sans-serif !important;font-size:u(12) !important;letter-spacing:u(1.2) !important;color:#000;margin-bottom:u(4)}
    html:root body .wxhd__ddl{font-size:u(13) !important;color:var(--wx-grey)}
    html:root body .wxhd__icons{right:u(42);gap:u(28)}
    html:root body .wxhd__icons a{width:u(19);height:u(19)}
    html:root body .wxhd__icons svg{width:u(19);height:u(19)}
  }
{%- endcapture -%}<style>{{ wxcss | replace: 'u(', 'calc(var(--u)*' }}</style>
