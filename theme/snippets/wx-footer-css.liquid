{%- capture wxcss -%}
  §.wxft{background:#fff;color:#000;padding:u(64) 0 u(185.9)}
  §.wxft__left{display:flex;flex-direction:column;align-items:center;text-align:center}
  §.wxft__title{color:#000;text-transform:uppercase !important;font-size:u(14.0001) !important;line-height:u(18.2001);letter-spacing:u(2.80002) !important;width:u(324)}
  §.wxft__form{margin-top:u(39)}
  §.wxft__row{display:flex;align-items:flex-start;gap:u(4)}
  §.wxft__row input{width:u(182.7);height:u(31);border:0;border-bottom:1px solid rgba(107,107,107,.6);border-radius:0;background:none;padding:0 u(10);font-size:u(12) !important;line-height:u(15);color:#000;outline:0;box-shadow:none}
  §.wxft__row input::placeholder{color:#C2C2C2;opacity:1}
  §.wxft__row button{width:u(89);height:u(34);border:0;border-radius:0;background:var(--wx-brown);color:#fff;font-size:u(10) !important;line-height:u(12);cursor:pointer;padding:0}
  §.wxft__ok{font-size:u(12) !important;margin-bottom:u(10) !important;color:var(--wx-brown)}
  §.wxft__note{width:u(254);margin-top:u(12) !important;color:#929292;font-size:u(10) !important;line-height:u(16);letter-spacing:u(.4) !important}
  §.wxft__social{display:flex;gap:u(16);margin-top:u(20.5)}
  §.wxft__social a{display:flex;align-items:center;justify-content:center;width:u(24);height:u(24)}
  §.wxft__social svg{width:100%;height:100%}
  §.wxft__legal{display:none}
  §.wxft__copy{margin-top:u(19.5) !important;color:var(--wx-grey);text-transform:uppercase !important;font-size:u(9.9999) !important;letter-spacing:u(.399996) !important}
  §.wxft__cols{display:grid;grid-template-columns:u(146) u(146);margin:u(50) 0 0 u(47)}
  §.wxft__col h3{font-family:'wxB',Arial,sans-serif !important;font-weight:700 !important;color:#000;text-transform:uppercase !important;font-size:u(9.61537) !important;line-height:u(13.4615);letter-spacing:u(1.92307) !important}
  §.wxft__col h3{margin-left:u(8.1) !important}
  §.wxft__col ul{list-style:none;margin:u(4.5) 0 0 u(10) !important}
  §.wxft__col li{height:u(20.12)}
  §.wxft__col a{font-family:'wxF',Arial,sans-serif !important;font-weight:700;color:var(--wx-grey);text-transform:uppercase !important;font-size:u(8.65384) !important;line-height:u(12.1154);letter-spacing:u(.865384) !important}
  §.wxwa{position:fixed;right:20px;bottom:20px;width:40px;height:40px;border-radius:50%;background:#000;display:flex;align-items:center;justify-content:center;z-index:50}
  §.wxwa svg{width:25.8px;height:25.8px}
  @media (min-width:750px){
    §.wxft{display:flex;padding:u(48) 0 0 u(89);min-height:107.143vh;box-sizing:border-box}
    §.wxft__left{align-items:flex-start;text-align:left;width:u(796)}
    §.wxft__title{width:auto;font-size:u(20.9677) !important;line-height:u(27.258);letter-spacing:u(4.19354) !important}
    §.wxft__form{margin-top:u(67)}
    §.wxft__row{gap:u(15)}
    §.wxft__row input{width:u(244.8);height:u(32);font-size:u(11) !important}
    §.wxft__row button{width:u(115);height:u(35);font-size:u(11) !important;line-height:u(13.2)}
    §.wxft__note{width:u(376);margin-top:u(9) !important;font-size:u(15.9368) !important;line-height:u(25.4988);letter-spacing:u(.637471) !important}
    §.wxft__social{gap:u(14);margin-top:u(25)}
    §.wxft__social a{width:u(32);height:u(32)}
    §.wxft__legal{display:flex;gap:u(28);margin:u(97) 0 0 u(-6)}
    §.wxft__legal a{font-weight:700;color:#000;text-transform:uppercase !important;font-size:u(10.1251) !important;line-height:u(14.1751)}
    §.wxft__copy{margin:u(11) 0 0 u(-5) !important;font-size:u(10.1251) !important;letter-spacing:0 !important}
    §.wxft__cols{grid-template-columns:u(258) u(258);margin:u(2.5) 0 0}
    §.wxft__col h3{margin-left:u(10.6) !important}
    §.wxft__col h3{font-family:'wxA',Arial,sans-serif !important;font-size:u(13.5) !important;line-height:u(18.9);letter-spacing:u(2.7) !important}
    §.wxft__col ul{margin:u(12) 0 0 u(10) !important}
    §.wxft__col li{height:u(31)}
    §.wxft__col a{font-family:'wxH',Arial,sans-serif !important;font-size:u(13.5) !important;line-height:u(18.9);letter-spacing:u(1.35) !important}
    §.wxwa{right:30px;bottom:30px;width:60px;height:60px}
    §.wxwa svg{width:36.6px;height:36.6px}
  }
  /* the link for the page you are on is highlighted, as on Wix */
  §.wxft__col a.is-on{color:#B64B2A}
  @media (min-width:750px){
    /* the newsletter button and the current-page link keep a fixed size on Wix while the rest of the footer scales */
    §.wxft__col a.is-on{font-size:12px !important;letter-spacing:1.2px !important}
    §.wxft__row button{font-size:11px !important;line-height:13.2px}
  }
  @media (max-width:749px){§.wxft__row button{font-size:10px !important;line-height:12px}§.wxft__col a.is-on{font-size:8.65384px !important;letter-spacing:.865384px !important}}
{%- endcapture -%}<style>{{ wxcss | replace: 'u(', 'calc(var(--u)*' | replace: '§', 'html:root body ' }}</style>
